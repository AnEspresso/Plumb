rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    match /sites/{siteId} {
      function isLive()   { return resource.data.mode == 'live'; }
      function stamped()  { return resource.data.memberUids != null; }
      function isMember() { return stamped() && uid() in resource.data.memberUids; }
      function isBuilder(){ return resource.data.members != null
                                   && resource.data.members[uid()] == 'builder'; }
      function infoOf() {
        return resource.data.get('meta', {}).get('memberInfo', {}).get(uid(), {});
      }
      function isOwner() {
        return isBuilder() && (
          !resource.data.get('meta', {}).get('memberInfo', {}).keys().hasAny([uid()])
          || infoOf().get('rpRole', '') == 'owner'
          || infoOf().get('owner', false) == true
        );
      }
      function membersHeld() {
        return request.resource.data.members.diff(resource.data.members).affectedKeys().size() == 0
          && request.resource.data.mode == resource.data.mode
          && request.resource.data.get('memberUids', []) == resource.data.get('memberUids', []);
      }
      function metaChanged() {
        return request.resource.data.meta.diff(resource.data.meta).affectedKeys();
      }
      function rootMetaOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['meta', 'updatedAt', 'updatedBy', 'updatedByUid', 'data']);
      }
      function builderHouseOk() {
        return isBuilder() && membersHeld() && rootMetaOnly()
          && !metaChanged().hasAny(['memberInfo','members','memberUids','mode']);
      }
      /* A homeowner signs a trade's crew instructions: packetSignoff.<trade>
         .homeowner. The builder's own sign-off on every trade stays exactly
         as it was. Only the trades this write changed are compared: a group
         of six is skipped with one hasAny, so the cost stays flat however
         many trades are signed (the old version compared all 29 and ran past
         the 1,000-expression limit, refusing every homeowner sign-off). No
         helper function per trade: each call costs more than the compare. */
      function clientSignoffOk() {
        let o = resource.data.meta.get('packetSignoff', {});
        let n = request.resource.data.meta.get('packetSignoff', {});
        let ch = n.diff(o).affectedKeys();
        return ch.size() == 0
          || (
            ch.hasOnly(['excav','concrete','framing','roofing','siding','hvac','plumb','elec','insul','drywall','finish','floor','paint','landscape','cabinets','counter','windows','garage','gutters','lowvolt','fireplace','waterproof','septic','appliance','cleaning','demo','steel','stucco','general'])
            && (!ch.hasAny(['excav', 'concrete', 'framing', 'roofing', 'siding', 'hvac']) || (
              (!('excav' in ch) || o.get('excav', {}).get('builder', {}) == n.get('excav', {}).get('builder', {}))
              && (!('concrete' in ch) || o.get('concrete', {}).get('builder', {}) == n.get('concrete', {}).get('builder', {}))
              && (!('framing' in ch) || o.get('framing', {}).get('builder', {}) == n.get('framing', {}).get('builder', {}))
              && (!('roofing' in ch) || o.get('roofing', {}).get('builder', {}) == n.get('roofing', {}).get('builder', {}))
              && (!('siding' in ch) || o.get('siding', {}).get('builder', {}) == n.get('siding', {}).get('builder', {}))
              && (!('hvac' in ch) || o.get('hvac', {}).get('builder', {}) == n.get('hvac', {}).get('builder', {}))
            ))
            && (!ch.hasAny(['plumb', 'elec', 'insul', 'drywall', 'finish', 'floor']) || (
              (!('plumb' in ch) || o.get('plumb', {}).get('builder', {}) == n.get('plumb', {}).get('builder', {}))
              && (!('elec' in ch) || o.get('elec', {}).get('builder', {}) == n.get('elec', {}).get('builder', {}))
              && (!('insul' in ch) || o.get('insul', {}).get('builder', {}) == n.get('insul', {}).get('builder', {}))
              && (!('drywall' in ch) || o.get('drywall', {}).get('builder', {}) == n.get('drywall', {}).get('builder', {}))
              && (!('finish' in ch) || o.get('finish', {}).get('builder', {}) == n.get('finish', {}).get('builder', {}))
              && (!('floor' in ch) || o.get('floor', {}).get('builder', {}) == n.get('floor', {}).get('builder', {}))
            ))
            && (!ch.hasAny(['paint', 'landscape', 'cabinets', 'counter', 'windows', 'garage']) || (
              (!('paint' in ch) || o.get('paint', {}).get('builder', {}) == n.get('paint', {}).get('builder', {}))
              && (!('landscape' in ch) || o.get('landscape', {}).get('builder', {}) == n.get('landscape', {}).get('builder', {}))
              && (!('cabinets' in ch) || o.get('cabinets', {}).get('builder', {}) == n.get('cabinets', {}).get('builder', {}))
              && (!('counter' in ch) || o.get('counter', {}).get('builder', {}) == n.get('counter', {}).get('builder', {}))
              && (!('windows' in ch) || o.get('windows', {}).get('builder', {}) == n.get('windows', {}).get('builder', {}))
              && (!('garage' in ch) || o.get('garage', {}).get('builder', {}) == n.get('garage', {}).get('builder', {}))
            ))
            && (!ch.hasAny(['gutters', 'lowvolt', 'fireplace', 'waterproof', 'septic', 'appliance']) || (
              (!('gutters' in ch) || o.get('gutters', {}).get('builder', {}) == n.get('gutters', {}).get('builder', {}))
              && (!('lowvolt' in ch) || o.get('lowvolt', {}).get('builder', {}) == n.get('lowvolt', {}).get('builder', {}))
              && (!('fireplace' in ch) || o.get('fireplace', {}).get('builder', {}) == n.get('fireplace', {}).get('builder', {}))
              && (!('waterproof' in ch) || o.get('waterproof', {}).get('builder', {}) == n.get('waterproof', {}).get('builder', {}))
              && (!('septic' in ch) || o.get('septic', {}).get('builder', {}) == n.get('septic', {}).get('builder', {}))
              && (!('appliance' in ch) || o.get('appliance', {}).get('builder', {}) == n.get('appliance', {}).get('builder', {}))
            ))
            && (!ch.hasAny(['cleaning', 'demo', 'steel', 'stucco', 'general']) || (
              (!('cleaning' in ch) || o.get('cleaning', {}).get('builder', {}) == n.get('cleaning', {}).get('builder', {}))
              && (!('demo' in ch) || o.get('demo', {}).get('builder', {}) == n.get('demo', {}).get('builder', {}))
              && (!('steel' in ch) || o.get('steel', {}).get('builder', {}) == n.get('steel', {}).get('builder', {}))
              && (!('stucco' in ch) || o.get('stucco', {}).get('builder', {}) == n.get('stucco', {}).get('builder', {}))
              && (!('general' in ch) || o.get('general', {}).get('builder', {}) == n.get('general', {}).get('builder', {}))
            ))
          );
      }
      function workShapeOk(oldW, newW, specAt) {
        return newW.keys().hasOnly(['fp', 'ack', 'installed'])
          && newW.fp is string
          && newW.fp.size() > 0
          && specAt is string
          && specAt.size() > 0
          && newW.fp == specAt
          && newW.keys().hasAll(['ack'])
          && newW.ack.keys().hasAll(['at'])
          && newW.ack.at is int
          && (
            !newW.keys().hasAny(['installed'])
            || (
              newW.installed.keys().hasAll(['at'])
              && newW.installed.at is int
            )
          )
          && (
            oldW.get('fp', '') == newW.fp
            || (
              (!oldW.keys().hasAny(['ack']) || newW.ack.at != oldW.get('ack', {}).get('at', 0))
              && (
                !newW.keys().hasAny(['installed'])
                || !oldW.keys().hasAny(['installed'])
                || newW.installed.at != oldW.get('installed', {}).get('at', 0)
              )
            )
          );
      }
      function crewWorkOk() {
        let t = infoOf().get('trade', '');
        let oldW = resource.data.meta.get('packetWork', {});
        let newW = request.resource.data.meta.get('packetWork', {});
        let specAt = resource.data.meta.get('packetSpecAt', {}).get(t, '');
        return t != ''
          && (
            !metaChanged().hasAny(['packetWork'])
            || (
              newW.diff(oldW).affectedKeys().hasOnly([t])
              && workShapeOk(oldW.get(t, {}), newW.get(t, {}), specAt)
            )
          );
      }
      /* A homeowner approves one invoice ("Approve this invoice", invApprove):
         one invoice goes from sent to approved and gains approvedAt. Nothing
         else in the list moves: no amount, line, title, payment or other
         invoice, no add or remove, no other status. The list is compared
         whole, without a loop: removeAll leaves exactly the one changed
         invoice on each side, and the rest must be equal and in order. Rules
         have no index lookup, so the one invoice being approved could change
         its place in the list (documented gap in rulescheck.js; its content
         cannot change). The cost stays flat however many invoices the house
         has (~300 expressions, measured with 1 to 200 invoices). */
      function invoiceApproveOk() {
        let o = resource.data.meta.get('invoices', []);
        let n = request.resource.data.meta.get('invoices', []);
        let now = n.removeAll(o);
        let was = o.removeAll(n);
        return n is list
          && n.size() == o.size()
          && now.size() == 1
          && was.size() == 1
          && n.removeAll(now) == o.removeAll(was)
          && now[0].diff(was[0]).affectedKeys().hasOnly(['status', 'approvedAt'])
          && was[0].get('status', '') == 'sent'
          && now[0].get('status', '') == 'approved'
          && now[0].get('approvedAt', null) is int;
      }
      function clientHouseOk() {
        let ch = metaChanged();
        return resource.data.members[uid()] == 'client'
          && membersHeld()
          && rootMetaOnly()
          && ch.hasOnly(['buildBrief','invoices','packetSignoff','packetSpecAt','packetStale','packetPrevSpec','t','updatedAt'])
          && clientSignoffOk()
          && (!ch.hasAny(['invoices']) || invoiceApproveOk());
      }
      function crewHouseOk() {
        return resource.data.members[uid()] == 'sub'
          && membersHeld()
          && rootMetaOnly()
          && metaChanged().hasOnly(['packetWork','t','updatedAt'])
          && crewWorkOk();
      }

      /* P2-4 (Release D): a house that is not live is closed. The example
         build keeps its practice houses on the phone (nothing in demo syncs),
         so no client has a reason to read, create or write a non-live house
         doc. A live house must also stay live: no write may flip its mode.
         The memberships query (memberUids array-contains me, the shape every
         app version listens with) cannot prove mode, so list stays scoped to
         the person's own memberships; the app drops non-live docs it gets. */
      allow get: if signedIn() && isLive() && isMember();
      allow list: if signedIn() && isMember();

      allow create: if signedIn()
        && request.resource.data.mode == 'live'
        && request.resource.data.members[uid()] == 'builder'
        && uid() in request.resource.data.memberUids;

      allow update: if signedIn() && isLive()
        && request.resource.data.mode == 'live'
        && (
          isOwner()
          || builderHouseOk()
          || clientHouseOk()
          || crewHouseOk()
        );
      allow delete: if false;

      match /{recordColl}/{recordId} {
        function site()  { return get(/databases/$(database)/documents/sites/$(siteId)).data; }
        function sMem()  { return site().members; }
        function sRole() { return sMem()[uid()]; }
        function sScoped(){ return site().mode == 'live'; }
        function rec() { return resource.data.get('data', {}); }
        function recNew() { return request.resource.data.get('data', {}); }
        function sInfo() {
          return site().get('meta', {}).get('memberInfo', {}).get(uid(), {});
        }
        function sMember() {
          return sRole() != null
            || uid() in site().get('memberUids', []);
        }
        function moneyOk() {
          return sRole() == 'builder' && (
            !site().get('meta', {}).get('memberInfo', {}).keys().hasAny([uid()])
            || sInfo().get('rpRole', '') == 'owner'
            || sInfo().get('owner', false) == true
            || sInfo().get('gates', {}).get('moneyJob', false) in [true, 1]
            || sInfo().get('gates', {}).get('moneyCo', false) in [true, 1]
          );
        }
        function moneyColl() { return recordColl in ['costs', 'mail']; }
        /* PR 0 (R-1 prep): a homeowner's selection write is an allowlist.
           The app writes a whole record as {data, updatedAt, updatedBy}. A
           homeowner Approves (data.approved + data.signed, clientSignoff) and
           answers their own questions (data.spec + data.specCustom values,
           clientSaveSpec). Nothing else moves: not the price, the status, the
           item, an invoice link or any amount, present or future. The old
           field-by-field rule ran past Firestore's 1,000-expression limit and
           refused every homeowner write; this one reads only what changed. */
        function specTechHeld(n, o) {
          return !n.get('spec', {}).diff(o.get('spec', {})).affectedKeys()
            .hasAny(['roughin','mount','mounting','height','supply','drain','location','loc','valve']);
        }
        /* Custom slots: same count, still a list. No slot-by-slot check: twelve
           of them cost ~400 expressions (measured), the same budget that broke
           the old rule. Builder slot text is not protected here (documented gap
           in rulescheck.js); money never lives in a slot. */
        function specCustomOk(n, o) {
          return n.specCustom is list
            && n.specCustom.size() == o.get('specCustom', []).size();
        }
        function clientSelOk() {
          let n = recNew();
          let o = rec();
          let ch = n.diff(o).affectedKeys();
          return recordColl == 'sel'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'updatedAt', 'updatedBy'])
            && ch.hasOnly(['approved', 'approvedAt', 'signed', 'spec', 'specCustom'])
            && (!ch.hasAny(['approved']) || n.approved is bool)
            && (!ch.hasAny(['approvedAt']) || n.approvedAt == null || n.approvedAt is int)
            && (!ch.hasAny(['signed']) || n.signed == null || n.signed is map)
            && (!ch.hasAny(['spec']) || (n.spec is map && specTechHeld(n, o)))
            && (!ch.hasAny(['specCustom']) || specCustomOk(n, o));
        }
        function crewOwnBk() {
          return recordColl == 'bk'
            && rec().get('subName', '') == sInfo().get('name', '')
            && rec().get('subName', '') != '';
        }
        function crewBkRespOk() {
          return crewOwnBk()
            && recNew().get('subName', '') == rec().get('subName', '')
            && recNew().get('trade', rec().get('trade', '')) == rec().get('trade', '')
            && recNew().diff(rec()).affectedKeys().hasOnly(['status', 'start', 'end', 'note']);
        }
        function crewItemOk() {
          return recordColl in ['items', 'logs']
            && rec().get('by', '') == sInfo().get('name', '')
            && rec().get('by', '') != ''
            && recNew().get('by', '') == rec().get('by', '');
        }

        /* P2-4: records under a house that is not live are closed too. */
        allow read: if signedIn() && sScoped()
          && (recordColl == 'pmts' ? sMember() && sRole() != 'sub'
              : recordColl in ['mail','costs'] ? moneyOk()
              : recordColl == 'bk' && sRole() == 'sub' ? crewOwnBk()
              : sMember());

        allow create: if signedIn() && sScoped()
          && ((sRole() == 'builder' && (!moneyColl() || moneyOk()))
              || (sRole() == 'sub' && recordColl in ['items','logs'])
              || (sRole() == 'client' && recordColl == 'items'));

        allow update: if signedIn() && sScoped()
          && ((sRole() == 'builder' && (!moneyColl() || moneyOk()))
              || (sRole() == 'sub' && crewItemOk())
              || (sRole() == 'sub' && crewBkRespOk())
              || (sRole() == 'client' && recordColl == 'items')
              || (sRole() == 'client' && clientSelOk()));

        allow delete: if signedIn() && sScoped()
          && sRole() == 'builder' && (!moneyColl() || moneyOk());
      }
    }

    /* invites/{code} reads stay exactly as they were: get by code, signed in.
       Never widen them - the doc holds the creator uid, house id, crew id and role. */
    match /invites/{code} {
      function inviteDoc() { return /databases/$(database)/documents/invites/$(code); }
      /* N-2 (Release D): one code, one person. The joiner flips claimed in the
         same batch that writes their claim; once claimed (or revoked) nobody
         else can claim it. */
      function claimFlipOk() {
        return resource.data.get('claimed', false) != true
          && resource.data.get('revoked', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt'])
          && request.resource.data.claimed == true
          && existsAfter(/databases/$(database)/documents/invites/$(code)/claims/$(uid()));
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == uid()
        && !request.resource.data.keys().hasAny(['claimed', 'claimedAt']);
      allow update: if signedIn() && (
        (resource.data.createdBy == uid()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked','revokedAt']))
        || claimFlipOk()
      );
      allow delete: if false;

      match /claims/{claimUid} {
        function claimOwner() {
          return signedIn()
            && get(inviteDoc()).data.createdBy == uid();
        }
        allow read: if signedIn() && (claimUid == uid() || claimOwner());
        allow create: if signedIn() && claimUid == uid()
          && get(inviteDoc()).data.get('claimed', false) != true
          && getAfter(inviteDoc()).data.get('claimed', false) == true;
        allow update, delete: if false;
      }
    }

    /* Invite option B (Release D): what the join screen may show before the
       person signs up - the builder's name and the street, nothing else. Get by
       exact code only, never listed, and only while the invite is open. Written
       by the builder who sent the invite; deleted on revoke and when the code
       is used (the app and the Cloud Functions both do it). */
    match /invitePreviews/{code} {
      function inviteDoc() { return /databases/$(database)/documents/invites/$(code); }
      function inviteIsMine() {
        return signedIn() && exists(inviteDoc()) && get(inviteDoc()).data.createdBy == uid();
      }
      function inviteOpen() {
        return exists(inviteDoc())
          && get(inviteDoc()).data.get('revoked', false) != true
          && get(inviteDoc()).data.get('claimed', false) != true;
      }
      allow get: if inviteOpen();
      allow list: if false;
      allow create: if inviteIsMine()
        && request.resource.data.keys().hasOnly(['builder', 'street'])
        && request.resource.data.keys().hasAll(['builder', 'street'])
        && request.resource.data.builder is string
        && request.resource.data.builder.size() <= 80
        && request.resource.data.street is string
        && request.resource.data.street.size() <= 120;
      allow update: if false;
      allow delete: if inviteIsMine();
    }

    match /orgs/{orgId} {
      /* Missing docs have no members map. A get on a new org id must succeed
         so the builder who already holds the jobs can create the record. */
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/orgs/$(orgId))
        || resource.data.members[uid()] != null
      );
      allow list: if false;
      allow create: if signedIn() && request.resource.data.members[uid()] == 'builder';
      allow update: if signedIn()
        && resource.data.members[uid()] == 'builder'
        && request.resource.data.members[uid()] == 'builder';
      allow delete: if false;
    }

    match /users/{userId} {
      function okUserShape() {
        return request.resource.data.keys().hasOnly(
                 ['name','email','rpRole','provider','fcm','tokens','t','createdAt','updatedAt','hatRole','hatSite'])
               && request.resource.size() < 50;
      }
      allow read: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId && okUserShape();
      allow delete: if false;
    }

    match /telemetry/{deviceId} {
      allow read, write: if false;
      match /events/{eventId} {
        allow read, write: if false;
      }
    }
    match /qb/{userId} { allow read, write: if false; }
    match /qbStates/{stateId} { allow read, write: if false; }

    match /packets/{token} {
      function workFresh() {
        let o = resource.data.get('work', {});
        let n = request.resource.data.work;
        return o.get('fp', '') == n.fp
          || (
            (!o.keys().hasAny(['ack']) || n.get('ack', {}).get('at', 0) != o.get('ack', {}).get('at', 0))
            && (
              !n.keys().hasAny(['installed'])
              || !o.keys().hasAny(['installed'])
              || n.get('installed', {}).get('at', 0) != o.get('installed', {}).get('at', 0)
            )
          );
      }
      function guestWorkOk() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['work'])
          || (
            resource.data.signed == true
            && resource.data.stale != true
            && resource.data.get('revoked', false) != true
            && resource.data.get('siteDeleted', false) != true
            && resource.data.specAt is string
            && resource.data.specAt.size() > 0
            && request.resource.data.work.keys().hasOnly(['fp', 'ack', 'installed'])
            && request.resource.data.work.fp is string
            && request.resource.data.work.fp == resource.data.specAt
            && (
              !request.resource.data.work.keys().hasAny(['installed'])
              || (
                request.resource.data.work.keys().hasAll(['ack'])
                && request.resource.data.work.ack.keys().hasAll(['at'])
                && request.resource.data.work.ack.at is int
              )
            )
            && workFresh()
          );
      }
      function guestFieldsOk() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['resp','q','work'])
          && guestWorkOk()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['resp'])
               || request.resource.data.resp.status in ['confirmed','change'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['q'])
               || request.resource.data.q.size() <= 10);
      }
      function packetPublisher() {
        return signedIn()
          && (
            (resource.data.createdBy == uid()
              && request.resource.data.createdBy == resource.data.createdBy)
            || (!resource.data.keys().hasAny(['createdBy'])
              && request.resource.data.createdBy == uid())
          );
      }
      function packetLive() {
        return resource.data.expires is int
          && resource.data.expires > request.time.toMillis()
          && resource.data.get('revoked', false) != true
          && resource.data.get('siteDeleted', false) != true;
      }

      allow get: if packetLive();
      allow list: if false;
      allow create: if signedIn()
                 && request.resource.data.createdBy == uid()
                 && request.resource.data.expires is int
                 && request.resource.data.resp == null;
      allow update: if (packetLive() && guestFieldsOk())
                 || (signedIn() && packetPublisher()
                     && resource.data.expires is int
                     && resource.data.expires > request.time.toMillis());
      allow delete: if signedIn() && resource.data.createdBy == uid();
    }
  }
}
