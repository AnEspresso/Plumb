rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function okUpload() {
      return request.resource.size < 25 * 1024 * 1024
             && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Closed: the example build keeps practice photos on the phone (2.430+).
    // Phones on 2.429 or older get a denied upload and keep them locally.
    match /demo/sites/{siteId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Live files follow the app's exact layout {kind}/{fileId} (MediaSync.path).
    // 'costs' receipts are builder-only; everything else stays member-wide.
    match /live/sites/{siteId}/{kind}/{fileId} {
      function site() {
        return firestore.get(/databases/(default)/documents/sites/$(siteId)).data;
      }
      function role() { return site().members[request.auth.uid]; }
      /* P2-4 (Release D): files follow the house. A house that is not live is closed. */
      function isMember() {
        return signedIn() && site().get('mode', '') == 'live'
               && site().members != null && role() != null;
      }
      function kindOk() { return kind != 'costs' || role() == 'builder'; }
      /* #11 (2.513.0): a document may also be a Word or Excel file (the app's document picker offers them).
         Only document folders (docs, and docs-<audience> if that layout lands); photos and receipts stay image or PDF. */
      function officeDocOk() {
        return kind.matches('docs(-.*)?')
               && request.resource.size < 25 * 1024 * 1024
               && request.resource.contentType.matches('application/msword|application/vnd[.]ms-excel|application/vnd[.]openxmlformats-officedocument[.]wordprocessingml[.]document|application/vnd[.]openxmlformats-officedocument[.]spreadsheetml[.]sheet');
      }
      allow read:  if isMember() && kindOk();
      allow write: if isMember() && kindOk() && (okUpload() || officeDocOk());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
