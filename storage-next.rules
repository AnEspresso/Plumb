rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function okUpload() {
      return request.resource.size < 25 * 1024 * 1024
             && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Closed: the example build keeps practice photos on the phone (2.430+).
    // Phones on 2.429 or older get a denied upload and keep them locally.
    match /demo/sites/{siteId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Live files follow the app's exact layout {kind}/{fileId} (CloudFiles.path).
    // Kinds: photos (member-wide), costs (builder-only receipts and paper
    // signatures), docs-team | docs-subs | docs-homeowner | docs-all (#5, batch 3:
    // one folder per audience, 2.512.0+) and docs (the old shared folder, kept
    // readable so no file has to move).
    match /live/sites/{siteId}/{kind}/{fileId} {
      function site() {
        return firestore.get(/databases/(default)/documents/sites/$(siteId)).data;
      }
      function role() { return site().members[request.auth.uid]; }
      /* P2-4 (Release D): files follow the house. A house that is not live is closed. */
      function isMember() {
        return signedIn() && site().get('mode', '') == 'live'
               && site().members != null && role() != null;
      }
      /* #5 (batch 3): a document file is read by whoever its audience lets in,
         and the document's own record (sites/{id}/docs/{fileId}, the same id)
         must let them in too, so moving a document to a narrower audience
         closes the copy in the old folder at once. Builders read every file. */
      function audLets(a) {
        return role() == 'builder'
          || (role() == 'sub' && a in ['subs', 'all'])
          || (role() == 'client' && a in ['homeowner', 'all']);
      }
      function recAud() {
        return firestore.get(/databases/(default)/documents/sites/$(siteId)/docs/$(fileId)).data.get('data', {}).get('aud', 'team');
      }
      function docKind() { return kind in ['docs-team', 'docs-subs', 'docs-homeowner', 'docs-all']; }
      function readOk() {
        return kind == 'photos'
          || (kind == 'costs' && role() == 'builder')
          || ((kind == 'docs' || docKind())
              && (role() == 'builder'
                  || ((kind == 'docs' || audLets(kind.split('-')[1])) && audLets(recAud()))));
      }
      function writeKindOk() {
        return kind == 'photos'
          || (kind in ['costs', 'docs'] && role() == 'builder')
          || (docKind() && role() == 'builder');
      }
      /* #7 (batch 3): a file is created once. Only the person who uploaded it
         (customMetadata.uploader, stamped by 2.512.0+) may replace or delete it;
         a file without that stamp is never overwritten or deleted by a phone
         (the server's own cleanup uses the Admin SDK). */
      function uploaderIsMe() {
        return resource.metadata != null
          && resource.metadata.get('uploader', '') == request.auth.uid;
      }
      function stampIsMe() {
        return request.resource.metadata == null
          || request.resource.metadata.get('uploader', request.auth.uid) == request.auth.uid;
      }
      allow read:   if isMember() && readOk();
      /* An upload over an existing file is checked as a create too: only a new
         path, or the uploader's own file. */
      allow create: if isMember() && writeKindOk() && okUpload() && stampIsMe()
                    && (resource == null || uploaderIsMe());
      allow update: if isMember() && writeKindOk() && stampIsMe() && uploaderIsMe();
      allow delete: if isMember() && uploaderIsMe();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
