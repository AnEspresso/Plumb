{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "site": "siteplumb-staging",
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules"],
    "headers": [{"source":"**","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"Content-Security-Policy","value":"default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'"}]}]
  }
}
